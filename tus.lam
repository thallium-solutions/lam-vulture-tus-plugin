#
# Tus 1.0.0 resumable-upload protocol (https://tus.io) on top of
# @lam/vulture. Implements Creation, Creation With Upload, Patch, Head,
# Termination, Length, Concatenation, and Checksum.
#
# Storage is a flat directory: every upload gets two files, ``<id>`` for the
# raw bytes and ``<id>.json`` for durable protocol metadata.

from @lam/vulture import Server, Request, Response, RouteOptions
from lamerrors import Result, Error

go! {
    import (
        "crypto/md5"
        "crypto/sha1"
        "crypto/sha256"
        "encoding/base64"
        "encoding/json"
        "fmt"
        "hash"
        "io"
        "os"
        "path/filepath"
        "strconv"
        "strings"
        "sync"
        "time"

        "github.com/google/uuid"
    )

    const lamTusVersion = "1.0.0"
    const lamTusVersions = "1.0.0"
    const lamTusExtensions = "creation,creation-with-upload,termination,concatenation,checksum"
    const lamTusChecksumAlgos = "sha1,sha256,md5"

    // On-disk metadata and filesystem primitives stay native because the
    // plugin must preserve arbitrary bytes and serialize append/update pairs.
    type lamTusInfo struct {
        ID         string            `json:"id"`
        Length     int64             `json:"length"`
        Offset     int64             `json:"offset"`
        Metadata   map[string]string `json:"metadata"`
        Complete   bool              `json:"complete"`
        CreatedAt  time.Time         `json:"createdAt"`
        FinishedAt time.Time         `json:"finishedAt,omitempty"`
        Concat     string            `json:"concat,omitempty"`
        Parts      []string          `json:"parts,omitempty"`
    }

    func lamTusHashFor(algo string) (hash.Hash, bool) {
        switch strings.ToLower(algo) {
        case "sha1":
            return sha1.New(), true
        case "sha256":
            return sha256.New(), true
        case "md5":
            return md5.New(), true
        default:
            return nil, false
        }
    }

    func lamTusVerifyChecksum(header string, chunk []byte) (bool, bool) {
        header = strings.TrimSpace(header)
        if header == "" {
            return true, true
        }
        parts := strings.SplitN(header, " ", 2)
        if len(parts) != 2 {
            return false, true
        }
        h, ok := lamTusHashFor(parts[0])
        if !ok {
            return false, false
        }
        want, err := base64.StdEncoding.DecodeString(strings.TrimSpace(parts[1]))
        if err != nil {
            return false, true
        }
        _, _ = h.Write(chunk)
        got := h.Sum(nil)
        if len(got) != len(want) {
            return false, true
        }
        for i := range got {
            if got[i] != want[i] {
                return false, true
            }
        }
        return true, true
    }

    var lamTusLocks sync.Map // map[string]*sync.Mutex

    func lamTusLockFor(id string) *sync.Mutex {
        if v, ok := lamTusLocks.Load(id); ok {
            return v.(*sync.Mutex)
        }
        m := &sync.Mutex{}
        actual, _ := lamTusLocks.LoadOrStore(id, m)
        return actual.(*sync.Mutex)
    }

    func lamTusInfoPath(dir, id string) string { return filepath.Join(dir, id+".json") }
    func lamTusBlobPath(dir, id string) string { return filepath.Join(dir, id) }

    func lamTusReadInfo(dir, id string) (*lamTusInfo, error) {
        b, err := os.ReadFile(lamTusInfoPath(dir, id))
        if err != nil {
            return nil, err
        }
        var info lamTusInfo
        if err := json.Unmarshal(b, &info); err != nil {
            return nil, err
        }
        return &info, nil
    }

    func lamTusWriteInfo(dir string, info *lamTusInfo) error {
        b, err := json.MarshalIndent(info, "", "  ")
        if err != nil {
            return err
        }
        return os.WriteFile(lamTusInfoPath(dir, info.ID), b, 0o644)
    }

    func lamTusParseMetadata(raw string) map[string]string {
        out := map[string]string{}
        if raw == "" {
            return out
        }
        for _, part := range strings.Split(raw, ",") {
            kv := strings.SplitN(strings.TrimSpace(part), " ", 2)
            if len(kv) == 0 {
                continue
            }
            key := kv[0]
            if len(kv) == 1 {
                out[key] = ""
                continue
            }
            if dec, err := base64.StdEncoding.DecodeString(kv[1]); err == nil {
                out[key] = string(dec)
            } else {
                out[key] = kv[1]
            }
        }
        return out
    }

    func lamTusError(kind, message string) *LAMMERGEIER.Result {
        return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(kind, message, nil))
    }

    func lamTusCompletionPayload(storeDir string, info *lamTusInfo) map[string]interface{} {
        payload := map[string]interface{}{
            "id":       info.ID,
            "length":   info.Length,
            "offset":   info.Offset,
            "metadata": info.Metadata,
            "path":     lamTusBlobPath(storeDir, info.ID),
        }
        if info.Concat != "" {
            payload["concat"] = info.Concat
        }
        if len(info.Parts) > 0 {
            payload["parts"] = info.Parts
        }
        return payload
    }

    func lamTusNotifyComplete(srv *Server, storeDir string, info *lamTusInfo) {
        if cb, ok := srv.Ctx["__tusComplete"]; ok {
            if fn, ok := cb.(func(map[string]interface{})); ok {
                payload := lamTusCompletionPayload(storeDir, info)
                func() {
                    defer func() { _ = recover() }()
                    fn(payload)
                }()
            }
        }
    }
}

func _tusBaseHeaders(response: Response) {
    _ = response.setHeader("Tus-Resumable", "1.0.0")
    _ = response.setHeader("Cache-Control", "no-store")
    _ = response.setHeader("Access-Control-Allow-Origin", "*")
    _ = response.setHeader("Access-Control-Expose-Headers", "Upload-Offset, Location, Upload-Length, Tus-Resumable, Tus-Version, Tus-Max-Size, Tus-Extension, Tus-Checksum-Algorithm, Upload-Metadata, Upload-Concat")
    _ = response.setHeader("Access-Control-Allow-Methods", "POST, HEAD, PATCH, OPTIONS, DELETE")
    _ = response.setHeader("Access-Control-Allow-Headers", "Authorization, Content-Type, Tus-Resumable, Upload-Length, Upload-Offset, Upload-Metadata, Upload-Concat, Upload-Checksum, X-Requested-With")
}

func _tusFail(response: Response, failure: any) {
    status: int = 500
    message: str = str(failure)
    go! {
        var kind string
        switch e := failure.(type) {
        case *LAMMERGEIER.Error:
            kind = e.Kind
            message = e.Message
        case LAMMERGEIER.Error:
            kind = e.Kind
            message = e.Message
        }
        switch kind {
        case "TusUploadNotFoundError":
            status = 404
        case "TusFinalUploadError":
            status = 403
        case "TusOffsetMismatchError":
            status = 409
        case "TusChecksumMismatchError":
            status = 460
        case "TusTooLargeError", "TusLengthExceededError":
            status = 413
        case "TusMediaTypeError":
            status = 415
        case "TusBadRequestError", "TusUnsupportedChecksumError":
            status = 400
        }
    }
    _ = response.setStatus(status)
    _ = response.setHeader("Content-Type", "text/plain")
    _ = response.text("tus: " + message)
}

func _tusChecksum(header: str, chunk: str) -> Result[bool] {
    go! {
        valid, supported := lamTusVerifyChecksum(header, []byte(chunk))
        if !supported {
            return lamTusError("TusUnsupportedChecksumError", "unsupported checksum algorithm")
        }
        if !valid {
            return lamTusError("TusChecksumMismatchError", "checksum mismatch")
        }
        return LAMMERGEIER.Result.Ok(true)
    }
}

func _tusCreate(storeDir: str, lengthHeader: str, metadataHeader: str, concatHeader: str, maxBytes: int) -> Result[str] {
    go! {
        length, err := strconv.ParseInt(lengthHeader, 10, 64)
        if err != nil || length < 0 {
            return lamTusError("TusBadRequestError", "invalid Upload-Length")
        }
        if maxBytes > 0 && length > int64(maxBytes) {
            return lamTusError("TusTooLargeError", "upload exceeds Tus-Max-Size")
        }

        id := uuid.NewString()
        info := &lamTusInfo{
            ID:        id,
            Length:    length,
            Offset:    0,
            Metadata:  lamTusParseMetadata(metadataHeader),
            CreatedAt: time.Now().UTC(),
        }
        if concatHeader == "partial" {
            info.Concat = "partial"
        }
        if err := lamTusWriteInfo(storeDir, info); err != nil {
            return lamTusError("TusPersistenceError", "cannot persist info: "+err.Error())
        }
        f, err := os.Create(lamTusBlobPath(storeDir, id))
        if err != nil {
            _ = os.Remove(lamTusInfoPath(storeDir, id))
            return lamTusError("TusPersistenceError", "cannot create blob: "+err.Error())
        }
        if err := f.Close(); err != nil {
            _ = os.Remove(lamTusBlobPath(storeDir, id))
            _ = os.Remove(lamTusInfoPath(storeDir, id))
            return lamTusError("TusPersistenceError", "cannot close blob: "+err.Error())
        }
        return LAMMERGEIER.Result.Ok(id)
    }
}

func _tusConcat(storeDir: str, concatHeader: str, metadataHeader: str, maxBytes: int, server: Server) -> Result[str] {
    go! {
        rest := strings.TrimSpace(strings.TrimPrefix(concatHeader, "final"))
        rest = strings.TrimSpace(strings.TrimPrefix(rest, ";"))
        if rest == "" {
            return lamTusError("TusBadRequestError", "Upload-Concat final missing parts")
        }

        partURLs := strings.Fields(rest)
        partIDs := make([]string, 0, len(partURLs))
        var total int64
        for _, u := range partURLs {
            seg := u
            if idx := strings.LastIndex(u, "/"); idx >= 0 {
                seg = u[idx+1:]
            }
            part, err := lamTusReadInfo(storeDir, seg)
            if err != nil {
                return lamTusError("TusBadRequestError", fmt.Sprintf("unknown part %q", seg))
            }
            if part.Concat != "partial" {
                return lamTusError("TusBadRequestError", fmt.Sprintf("part %q is not Upload-Concat: partial", seg))
            }
            if !part.Complete {
                return lamTusError("TusBadRequestError", fmt.Sprintf("part %q is not complete", seg))
            }
            partIDs = append(partIDs, seg)
            total += part.Length
        }
        if maxBytes > 0 && total > int64(maxBytes) {
            return lamTusError("TusTooLargeError", "concatenated upload exceeds Tus-Max-Size")
        }

        id := uuid.NewString()
        blobPath := lamTusBlobPath(storeDir, id)
        out, err := os.Create(blobPath)
        if err != nil {
            return lamTusError("TusPersistenceError", "cannot create final blob: "+err.Error())
        }
        clean := func() {
            _ = out.Close()
            _ = os.Remove(blobPath)
        }
        for _, pid := range partIDs {
            in, err := os.Open(lamTusBlobPath(storeDir, pid))
            if err != nil {
                clean()
                return lamTusError("TusPersistenceError", "cannot read part blob: "+err.Error())
            }
            _, copyErr := io.Copy(out, in)
            closeErr := in.Close()
            if copyErr != nil {
                clean()
                return lamTusError("TusPersistenceError", "cannot copy part: "+copyErr.Error())
            }
            if closeErr != nil {
                clean()
                return lamTusError("TusPersistenceError", "cannot close part blob: "+closeErr.Error())
            }
        }
        if err := out.Close(); err != nil {
            _ = os.Remove(blobPath)
            return lamTusError("TusPersistenceError", "cannot close final blob: "+err.Error())
        }

        now := time.Now().UTC()
        info := &lamTusInfo{
            ID:         id,
            Length:     total,
            Offset:     total,
            Metadata:   lamTusParseMetadata(metadataHeader),
            Complete:   true,
            CreatedAt:  now,
            FinishedAt: now,
            Concat:     "final",
            Parts:      partIDs,
        }
        if err := lamTusWriteInfo(storeDir, info); err != nil {
            _ = os.Remove(blobPath)
            return lamTusError("TusPersistenceError", "cannot persist final info: "+err.Error())
        }
        lamTusNotifyComplete(server, storeDir, info)
        return LAMMERGEIER.Result.Ok(id)
    }
}

func _tusPersistChunk(storeDir: str, id: str, offsetHeader: str, chunk: str, server: Server) -> Result[int] {
    go! {
        wantOffset, err := strconv.ParseInt(offsetHeader, 10, 64)
        if err != nil || wantOffset < 0 {
            return lamTusError("TusBadRequestError", "invalid Upload-Offset")
        }

        mu := lamTusLockFor(id)
        mu.Lock()
        defer mu.Unlock()

        info, err := lamTusReadInfo(storeDir, id)
        if err != nil {
            if os.IsNotExist(err) {
                return lamTusError("TusUploadNotFoundError", "upload not found")
            }
            return lamTusError("TusPersistenceError", "cannot read upload info: "+err.Error())
        }
        if info.Concat == "final" {
            return lamTusError("TusFinalUploadError", "cannot PATCH a final upload")
        }
        if info.Offset != wantOffset {
            return lamTusError("TusOffsetMismatchError", fmt.Sprintf("offset mismatch — got %d, want %d", wantOffset, info.Offset))
        }

        data := []byte(chunk)
        if int64(len(data)) > info.Length-info.Offset {
            return lamTusError("TusLengthExceededError", "chunk exceeds declared Upload-Length")
        }
        if len(data) == 0 {
            return LAMMERGEIER.Result.Ok(int(info.Offset))
        }

        blobPath := lamTusBlobPath(storeDir, info.ID)
        f, err := os.OpenFile(blobPath, os.O_WRONLY|os.O_APPEND, 0o644)
        if err != nil {
            return lamTusError("TusChunkPersistenceError", "cannot open upload blob: "+err.Error())
        }
        before, statErr := f.Stat()
        if statErr != nil {
            _ = f.Close()
            return lamTusError("TusChunkPersistenceError", "cannot stat upload blob: "+statErr.Error())
        }
        n, writeErr := f.Write(data)
        if writeErr == nil && n != len(data) {
            writeErr = io.ErrShortWrite
        }
        closeErr := f.Close()
        if writeErr != nil {
            _ = os.Truncate(blobPath, before.Size())
            return lamTusError("TusChunkPersistenceError", "cannot append upload chunk: "+writeErr.Error())
        }
        if closeErr != nil {
            _ = os.Truncate(blobPath, before.Size())
            return lamTusError("TusChunkPersistenceError", "cannot close upload blob: "+closeErr.Error())
        }

        info.Offset += int64(n)
        becameComplete := !info.Complete && info.Offset == info.Length
        if becameComplete {
            info.Complete = true
            info.FinishedAt = time.Now().UTC()
        }
        if err := lamTusWriteInfo(storeDir, info); err != nil {
            rollbackErr := os.Truncate(blobPath, before.Size())
            if rollbackErr != nil {
                return lamTusError("TusChunkPersistenceError", "cannot persist offset: "+err.Error()+"; rollback failed: "+rollbackErr.Error())
            }
            return lamTusError("TusChunkPersistenceError", "cannot persist offset: "+err.Error())
        }

        if becameComplete {
            lamTusNotifyComplete(server, storeDir, info)
        }
        return LAMMERGEIER.Result.Ok(int(info.Offset))
    }
}

func _tusHeadHeaders(storeDir: str, id: str, mountPath: str) -> Result[dict[str, str]] {
    go! {
        info, err := lamTusReadInfo(storeDir, id)
        if err != nil {
            if os.IsNotExist(err) {
                return lamTusError("TusUploadNotFoundError", "upload not found")
            }
            return lamTusError("TusPersistenceError", "cannot read upload info: "+err.Error())
        }
        headers := map[string]string{
            "Upload-Length": strconv.FormatInt(info.Length, 10),
            "Upload-Offset": strconv.FormatInt(info.Offset, 10),
        }
        if len(info.Metadata) > 0 {
            pairs := []string{}
            for k, v := range info.Metadata {
                pairs = append(pairs, k+" "+base64.StdEncoding.EncodeToString([]byte(v)))
            }
            headers["Upload-Metadata"] = strings.Join(pairs, ",")
        }
        if info.Concat == "partial" {
            headers["Upload-Concat"] = "partial"
        } else if info.Concat == "final" {
            urls := []string{}
            for _, pid := range info.Parts {
                urls = append(urls, mountPath+"/"+pid)
            }
            headers["Upload-Concat"] = "final;" + strings.Join(urls, " ")
        }
        return LAMMERGEIER.Result.Ok(headers)
    }
}

func _tusDelete(storeDir: str, id: str) -> Result[bool] {
    go! {
        mu := lamTusLockFor(id)
        mu.Lock()
        defer mu.Unlock()

        if err := os.Remove(lamTusBlobPath(storeDir, id)); err != nil && !os.IsNotExist(err) {
            return lamTusError("TusPersistenceError", "cannot remove upload blob: "+err.Error())
        }
        if err := os.Remove(lamTusInfoPath(storeDir, id)); err != nil && !os.IsNotExist(err) {
            return lamTusError("TusPersistenceError", "cannot remove upload info: "+err.Error())
        }
        lamTusLocks.Delete(id)
        return LAMMERGEIER.Result.Ok(true)
    }
}

func _tusOptions(_request: Request, response: Response, maxBytes: int) {
    _tusBaseHeaders(response)
    _ = response.setHeader("Tus-Version", "1.0.0")
    _ = response.setHeader("Tus-Extension", "creation,creation-with-upload,termination,concatenation,checksum")
    _ = response.setHeader("Tus-Checksum-Algorithm", "sha1,sha256,md5")
    if maxBytes > 0 {
        _ = response.setHeader("Tus-Max-Size", str(maxBytes))
    }
    _ = response.setStatus(204)
    response.sent = true
}

func _tusPost(request: Request, response: Response, server: Server, mountPath: str, storeDir: str, maxBytes: int) {
    _tusBaseHeaders(response)
    concatHeader: str = request.header("Upload-Concat").trim()
    created: Result[str]
    if concatHeader.startsWith("final") {
        created = _tusConcat(storeDir, concatHeader, request.header("Upload-Metadata"), maxBytes, server)
    } else {
        created = _tusCreate(storeDir, request.header("Upload-Length"), request.header("Upload-Metadata"), concatHeader, maxBytes)
    }
    if not created.ok() {
        _tusFail(response, created.error)
        return
    }

    id: str = created.unwrap()
    if not concatHeader.startsWith("final") and request.header("Content-Type").startsWith("application/offset+octet-stream") and len(request.body) > 0 {
        checksum: Result[bool] = _tusChecksum(request.header("Upload-Checksum"), request.body)
        if not checksum.ok() {
            _tusFail(response, checksum.error)
            return
        }
        persisted: Result[int] = _tusPersistChunk(storeDir, id, "0", request.body, server)
        if not persisted.ok() {
            _tusFail(response, persisted.error)
            return
        }
        _ = response.setHeader("Upload-Offset", str(persisted.unwrap()))
    }

    _ = response.setHeader("Location", mountPath + "/" + id)
    _ = response.setStatus(201)
    response.sent = true
}

func _tusHead(request: Request, response: Response, mountPath: str, storeDir: str) {
    _tusBaseHeaders(response)
    found: Result[dict[str, str]] = _tusHeadHeaders(storeDir, request.params[":id"], mountPath)
    if not found.ok() {
        _tusFail(response, found.error)
        return
    }
    headers: dict[str, str] = found.unwrap()
    _ = response.setHeaders(headers)
    _ = response.setStatus(200)
    response.sent = true
}

func _tusPatch(request: Request, response: Response, server: Server, storeDir: str) {
    _tusBaseHeaders(response)
    if not request.header("Content-Type").startsWith("application/offset+octet-stream") {
        _tusFail(response, Error("TusMediaTypeError", "Content-Type must be application/offset+octet-stream", None))
        return
    }
    checksum: Result[bool] = _tusChecksum(request.header("Upload-Checksum"), request.body)
    if not checksum.ok() {
        _tusFail(response, checksum.error)
        return
    }
    persisted: Result[int] = _tusPersistChunk(storeDir, request.params[":id"], request.header("Upload-Offset"), request.body, server)
    if not persisted.ok() {
        _tusFail(response, persisted.error)
        return
    }
    _ = response.setHeader("Upload-Offset", str(persisted.unwrap()))
    _ = response.setStatus(204)
    response.sent = true
}

func _tusDeleteHandler(request: Request, response: Response, storeDir: str) {
    _tusBaseHeaders(response)
    removed: Result[bool] = _tusDelete(storeDir, request.params[":id"])
    if not removed.ok() {
        _tusFail(response, removed.error)
        return
    }
    _ = response.setStatus(204)
    response.sent = true
}

func tusUploads(server: Server, mountPath: str, storeDir: str, maxBytes: int) -> Result[bool] {
    #- Mount tus 1.0 endpoints. Invalid configuration and store-directory
    creation failures are returned as explicit ``Result.Err`` values. -#
    if not mountPath.startsWith("/") or(len(mountPath) > 1 and mountPath.endsWith("/")) {
        return Result.Err(Error("TusConfigurationError", "mountPath must be absolute and must not end with '/'", None))
    }
    if storeDir.trim() == "" {
        return Result.Err(Error("TusConfigurationError", "storeDir must not be empty", None))
    }
    if maxBytes < 0 {
        return Result.Err(Error("TusConfigurationError", "maxBytes must be zero or positive", None))
    }
    go! {
        if err := os.MkdirAll(storeDir, 0o755); err != nil {
            return lamTusError("TusConfigurationError", "cannot create store dir "+storeDir+": "+err.Error())
        }
    }

    controlOptions: RouteOptions = RouteOptions()
    controlOptions.tags = ["tus"]
    uploadOptions: RouteOptions = RouteOptions(maxBytes)
    uploadOptions.tags = ["tus"]
    uploadOptions.consumes = ["application/offset+octet-stream"]

    optionsHandler: func(Request, Response) = lambda(request: Request, response: Response) -> None {
        _tusOptions(request, response, maxBytes)
    }
    postHandler: func(Request, Response) = lambda(request: Request, response: Response) -> None {
        _tusPost(request, response, server, mountPath, storeDir, maxBytes)
    }
    headHandler: func(Request, Response) = lambda(request: Request, response: Response) -> None {
        _tusHead(request, response, mountPath, storeDir)
    }
    patchHandler: func(Request, Response) = lambda(request: Request, response: Response) -> None {
        _tusPatch(request, response, server, storeDir)
    }
    deleteHandler: func(Request, Response) = lambda(request: Request, response: Response) -> None {
        _tusDeleteHandler(request, response, storeDir)
    }

    server.options(mountPath, optionsHandler, controlOptions)
    server.post(mountPath, postHandler, uploadOptions)
    server.head(mountPath + "/:id", headHandler, controlOptions)
    server.patch(mountPath + "/:id", patchHandler, uploadOptions)
    server.del(mountPath + "/:id", deleteHandler, controlOptions)
    return Result.Ok(true)
}

func tusGc(storeDir: str, maxAgeHours: int) -> Result[int] {
    #- Delete upload pairs older than ``maxAgeHours``. Directory reads,
    metadata decoding, and removals fail explicitly instead of returning a
    partial/sentinel count. -#
    if maxAgeHours < 0 {
        return Result.Err(Error("TusConfigurationError", "maxAgeHours must be zero or positive", None))
    }
    go! {
        entries, err := os.ReadDir(storeDir)
        if err != nil {
            return lamTusError("TusGcError", "cannot read store directory: "+err.Error())
        }
        cutoff := time.Now().Add(-time.Duration(maxAgeHours) * time.Hour)
        removed := 0
        for _, entry := range entries {
            if !strings.HasSuffix(entry.Name(), ".json") {
                continue
            }
            id := strings.TrimSuffix(entry.Name(), ".json")
            info, err := lamTusReadInfo(storeDir, id)
            if err != nil {
                return lamTusError("TusGcError", "cannot read metadata for "+id+": "+err.Error())
            }
            if !info.CreatedAt.Before(cutoff) {
                continue
            }

            mu := lamTusLockFor(id)
            mu.Lock()
            if err := os.Remove(lamTusBlobPath(storeDir, id)); err != nil && !os.IsNotExist(err) {
                mu.Unlock()
                return lamTusError("TusGcError", "cannot remove blob for "+id+": "+err.Error())
            }
            if err := os.Remove(lamTusInfoPath(storeDir, id)); err != nil {
                mu.Unlock()
                return lamTusError("TusGcError", "cannot remove metadata for "+id+": "+err.Error())
            }
            mu.Unlock()
            lamTusLocks.Delete(id)
            removed++
        }
        return LAMMERGEIER.Result.Ok(removed)
    }
}
