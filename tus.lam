#
# Tus 1.0.0 resumable-upload protocol (https://tus.io) on top of
# @lam/vulture. Implements Creation, Creation With Upload, Patch, Head,
# Termination, Length, Concatenation, and Checksum.
#
# Storage is a flat directory: every upload gets two files, ``<id>`` for the
# raw bytes and ``<id>.json`` for durable protocol metadata.

from @lam/vulture import Server, Request, Response

go! {
    import (
        "crypto/md5"
        "crypto/sha1"
        "crypto/sha256"
        "encoding/base64"
        "encoding/json"
        "fmt"
        "hash"
        "io"
        "os"
        "path/filepath"
        "strconv"
        "strings"
        "sync"
        "time"

        "github.com/google/uuid"
    )

    const lamTusVersion = "1.0.0"
    const lamTusVersions = "1.0.0"
    const lamTusExtensions = "creation,creation-with-upload,termination,concatenation,checksum"
    const lamTusChecksumAlgos = "sha1,sha256,md5"

    // On-disk metadata. This and the filesystem helpers remain Go because the
    // plugin durably streams binary data and updates offsets under a lock.
    type lamTusInfo struct {
        ID         string            `json:"id"`
        Length     int64             `json:"length"`
        Offset     int64             `json:"offset"`
        Metadata   map[string]string `json:"metadata"`
        Complete   bool              `json:"complete"`
        CreatedAt  time.Time         `json:"createdAt"`
        FinishedAt time.Time         `json:"finishedAt,omitempty"`
        Concat     string            `json:"concat,omitempty"`
        Parts      []string          `json:"parts,omitempty"`
    }

    func lamTusHashFor(algo string) (hash.Hash, bool) {
        switch strings.ToLower(algo) {
        case "sha1":
            return sha1.New(), true
        case "sha256":
            return sha256.New(), true
        case "md5":
            return md5.New(), true
        default:
            return nil, false
        }
    }

    // Return (valid, supported). A missing checksum is valid because checksum
    // is an optional protocol extension.
    func lamTusVerifyChecksum(header string, chunk []byte) (bool, bool) {
        header = strings.TrimSpace(header)
        if header == "" {
            return true, true
        }
        parts := strings.SplitN(header, " ", 2)
        if len(parts) != 2 {
            return false, true
        }
        h, ok := lamTusHashFor(parts[0])
        if !ok {
            return false, false
        }
        want, err := base64.StdEncoding.DecodeString(strings.TrimSpace(parts[1]))
        if err != nil {
            return false, true
        }
        h.Write(chunk)
        got := h.Sum(nil)
        if len(got) != len(want) {
            return false, true
        }
        for i := range got {
            if got[i] != want[i] {
                return false, true
            }
        }
        return true, true
    }

    // Per-upload locking protects offsets and append ordering under parallel
    // PATCH requests. sync.Map avoids a global lock on unrelated uploads.
    var lamTusLocks sync.Map // map[string]*sync.Mutex

    func lamTusLockFor(id string) *sync.Mutex {
        if v, ok := lamTusLocks.Load(id); ok {
            return v.(*sync.Mutex)
        }
        m := &sync.Mutex{}
        actual, _ := lamTusLocks.LoadOrStore(id, m)
        return actual.(*sync.Mutex)
    }

    func lamTusInfoPath(dir, id string) string { return filepath.Join(dir, id+".json") }
    func lamTusBlobPath(dir, id string) string { return filepath.Join(dir, id) }

    func lamTusReadInfo(dir, id string) (*lamTusInfo, error) {
        b, err := os.ReadFile(lamTusInfoPath(dir, id))
        if err != nil {
            return nil, err
        }
        var info lamTusInfo
        if err := json.Unmarshal(b, &info); err != nil {
            return nil, err
        }
        return &info, nil
    }

    func lamTusWriteInfo(dir string, info *lamTusInfo) error {
        b, err := json.MarshalIndent(info, "", "  ")
        if err != nil {
            return err
        }
        return os.WriteFile(lamTusInfoPath(dir, info.ID), b, 0o644)
    }

    // Parse Upload-Metadata's comma-separated "key base64(value)" pairs.
    func lamTusParseMetadata(raw string) map[string]string {
        out := map[string]string{}
        if raw == "" {
            return out
        }
        for _, part := range strings.Split(raw, ",") {
            kv := strings.SplitN(strings.TrimSpace(part), " ", 2)
            if len(kv) == 0 {
                continue
            }
            key := kv[0]
            if len(kv) == 1 {
                out[key] = ""
                continue
            }
            if dec, err := base64.StdEncoding.DecodeString(kv[1]); err == nil {
                out[key] = string(dec)
            } else {
                out[key] = kv[1]
            }
        }
        return out
    }

    func lamTusBaseHeaders(res *Response) {
        res.Headers["Tus-Resumable"] = lamTusVersion
        res.Headers["Cache-Control"] = "no-store"
    }

    func lamTusCorsHeaders(res *Response) {
        res.Headers["Access-Control-Allow-Origin"] = "*"
        res.Headers["Access-Control-Expose-Headers"] = "Upload-Offset, Location, Upload-Length, Tus-Resumable, Tus-Version, Tus-Max-Size, Tus-Extension, Tus-Checksum-Algorithm, Upload-Metadata, Upload-Concat"
        res.Headers["Access-Control-Allow-Methods"] = "POST, HEAD, PATCH, OPTIONS, DELETE"
        res.Headers["Access-Control-Allow-Headers"] = "Authorization, Content-Type, Tus-Resumable, Upload-Length, Upload-Offset, Upload-Metadata, Upload-Concat, Upload-Checksum, X-Requested-With"
    }
}

func tusUploads(srv: Server, mountPath: str, storeDir: str, maxBytes: int) {
    #- Mount tus 1.0 endpoints at ``mountPath`` and store upload data under
    ``storeDir``. ``maxBytes`` limits declared upload sizes
    pass 0 for no
    configured maximum.

    Registered routes:

    * ``OPTIONS < mount > `` — protocol capabilities
    * ``POST < mount > `` — create or concatenate an upload
    * ``HEAD < mount > /: id`` — inspect upload offset and metadata
    * ``PATCH < mount > /: id`` — append a binary chunk
    * ``DELETE < mount > /: id`` — terminate and remove an upload

    Set ``srv.ctx["__tusComplete"]`` to a callback that accepts the upload
    info dict when an upload becomes complete. -  #
    go! {
        if err := os.MkdirAll(storeDir, 0o755); err != nil {
            fmt.Fprintf(os.Stderr, "tus: cannot create store dir %s: %v\n", storeDir, err)
            return
        }
    }

    optionsHandler: any = None
    postHandler: any = None
    headHandler: any = None
    patchHandler: any = None
    deleteHandler: any = None

    # Route handlers remain native Go callbacks because @lam/vulture's
    # low-level handler contract is func(*Request, *Response), and because
    # request bodies cross the generated binary boundary here.
    go! {
        local := srv

        optionsHandler = func(req *Request, res *Response) {
            lamTusBaseHeaders(res)
            lamTusCorsHeaders(res)
            res.Headers["Tus-Version"] = lamTusVersions
            res.Headers["Tus-Extension"] = lamTusExtensions
            res.Headers["Tus-Checksum-Algorithm"] = lamTusChecksumAlgos
            if maxBytes > 0 {
                res.Headers["Tus-Max-Size"] = strconv.FormatInt(int64(maxBytes), 10)
            }
            res.Status = 204
            res.Sent = true
        }

        postHandler = func(req *Request, res *Response) {
            lamTusBaseHeaders(res)
            lamTusCorsHeaders(res)

            concatHdr := strings.TrimSpace(req.Header("Upload-Concat"))

            if strings.HasPrefix(concatHdr, "final") {
                rest := strings.TrimSpace(strings.TrimPrefix(concatHdr, "final"))
                rest = strings.TrimPrefix(rest, ";")
                rest = strings.TrimSpace(rest)
                if rest == "" {
                    res.Status = 400
                    res.Headers["Content-Type"] = "text/plain"
                    res.Body = "tus: Upload-Concat final missing parts"
                    res.Sent = true
                    return
                }
                partURLs := strings.Fields(rest)
                partIDs := make([]string, 0, len(partURLs))
                var total int64
                for _, u := range partURLs {
                    seg := u
                    if idx := strings.LastIndex(u, "/"); idx >= 0 {
                        seg = u[idx+1:]
                    }
                    part, err := lamTusReadInfo(storeDir, seg)
                    if err != nil {
                        res.Status = 400
                        res.Headers["Content-Type"] = "text/plain"
                        res.Body = fmt.Sprintf("tus: unknown part %q", seg)
                        res.Sent = true
                        return
                    }
                    if part.Concat != "partial" {
                        res.Status = 400
                        res.Headers["Content-Type"] = "text/plain"
                        res.Body = fmt.Sprintf("tus: part %q is not Upload-Concat: partial", seg)
                        res.Sent = true
                        return
                    }
                    if !part.Complete {
                        res.Status = 400
                        res.Headers["Content-Type"] = "text/plain"
                        res.Body = fmt.Sprintf("tus: part %q is not complete", seg)
                        res.Sent = true
                        return
                    }
                    partIDs = append(partIDs, seg)
                    total += part.Length
                }
                if maxBytes > 0 && total > int64(maxBytes) {
                    res.Status = 413
                    res.Headers["Content-Type"] = "text/plain"
                    res.Body = "tus: concatenated upload exceeds Tus-Max-Size"
                    res.Sent = true
                    return
                }

                id := uuid.NewString()
                out, err := os.Create(lamTusBlobPath(storeDir, id))
                if err != nil {
                    res.Status = 500
                    res.Body = "tus: cannot create final blob: " + err.Error()
                    res.Sent = true
                    return
                }
                for _, pid := range partIDs {
                    in, err := os.Open(lamTusBlobPath(storeDir, pid))
                    if err != nil {
                        out.Close()
                        os.Remove(lamTusBlobPath(storeDir, id))
                        res.Status = 500
                        res.Body = "tus: cannot read part blob: " + err.Error()
                        res.Sent = true
                        return
                    }
                    _, err = io.Copy(out, in)
                    in.Close()
                    if err != nil {
                        out.Close()
                        os.Remove(lamTusBlobPath(storeDir, id))
                        res.Status = 500
                        res.Body = "tus: cannot copy part: " + err.Error()
                        res.Sent = true
                        return
                    }
                }
                out.Close()

                info := &lamTusInfo{
                    ID:         id,
                    Length:     total,
                    Offset:     total,
                    Metadata:   lamTusParseMetadata(req.Header("Upload-Metadata")),
                    Complete:   true,
                    CreatedAt:  time.Now().UTC(),
                    FinishedAt: time.Now().UTC(),
                    Concat:     "final",
                    Parts:      partIDs,
                }
                _ = lamTusWriteInfo(storeDir, info)

                if cb, ok := local.Ctx["__tusComplete"]; ok {
                    if fn, ok := cb.(func(map[string]interface{})); ok {
                        payload := map[string]interface{}{
                            "id":       info.ID,
                            "length":   info.Length,
                            "offset":   info.Offset,
                            "metadata": info.Metadata,
                            "path":     lamTusBlobPath(storeDir, info.ID),
                            "concat":   "final",
                            "parts":    info.Parts,
                        }
                        func() {
                            defer func() { _ = recover() }()
                            fn(payload)
                        }()
                    }
                }

                res.Headers["Location"] = mountPath + "/" + id
                res.Status = 201
                res.Sent = true
                return
            }

            lengthStr := req.Header("Upload-Length")
            length, err := strconv.ParseInt(lengthStr, 10, 64)
            if err != nil || length < 0 {
                res.Status = 400
                res.Headers["Content-Type"] = "text/plain"
                res.Body = "tus: invalid Upload-Length"
                res.Sent = true
                return
            }
            if maxBytes > 0 && length > int64(maxBytes) {
                res.Status = 413
                res.Headers["Content-Type"] = "text/plain"
                res.Body = "tus: upload exceeds Tus-Max-Size"
                res.Sent = true
                return
            }

            id := uuid.NewString()
            info := &lamTusInfo{
                ID:        id,
                Length:    length,
                Offset:    0,
                Metadata:  lamTusParseMetadata(req.Header("Upload-Metadata")),
                CreatedAt: time.Now().UTC(),
            }
            if concatHdr == "partial" {
                info.Concat = "partial"
            }
            if err := lamTusWriteInfo(storeDir, info); err != nil {
                res.Status = 500
                res.Body = "tus: cannot persist info: " + err.Error()
                res.Sent = true
                return
            }
            f, err := os.Create(lamTusBlobPath(storeDir, id))
            if err != nil {
                res.Status = 500
                res.Body = "tus: cannot create blob: " + err.Error()
                res.Sent = true
                return
            }
            f.Close()

            ct := req.Header("Content-Type")
            if strings.HasPrefix(ct, "application/offset+octet-stream") && len(req.Body) > 0 {
                chunk := []byte(req.Body)
                csum := req.Header("Upload-Checksum")
                if csum != "" {
                    valid, supported := lamTusVerifyChecksum(csum, chunk)
                    if !supported {
                        res.Status = 400
                        res.Headers["Content-Type"] = "text/plain"
                        res.Body = "tus: unsupported checksum algorithm"
                        res.Sent = true
                        return
                    }
                    if !valid {
                        res.Status = 460
                        res.Headers["Content-Type"] = "text/plain"
                        res.Body = "tus: checksum mismatch"
                        res.Sent = true
                        return
                    }
                }
                lamTusAppendChunk(storeDir, info, chunk, local)
                res.Headers["Upload-Offset"] = strconv.FormatInt(info.Offset, 10)
            }

            res.Headers["Location"] = mountPath + "/" + id
            res.Status = 201
            res.Sent = true
        }

        headHandler = func(req *Request, res *Response) {
            lamTusBaseHeaders(res)
            lamTusCorsHeaders(res)
            id := req.Params[":id"]
            info, err := lamTusReadInfo(storeDir, id)
            if err != nil {
                res.Status = 404
                res.Sent = true
                return
            }
            res.Headers["Upload-Length"] = strconv.FormatInt(info.Length, 10)
            res.Headers["Upload-Offset"] = strconv.FormatInt(info.Offset, 10)
            if len(info.Metadata) > 0 {
                pairs := []string{}
                for k, v := range info.Metadata {
                    pairs = append(pairs, k+" "+base64.StdEncoding.EncodeToString([]byte(v)))
                }
                res.Headers["Upload-Metadata"] = strings.Join(pairs, ",")
            }
            if info.Concat == "partial" {
                res.Headers["Upload-Concat"] = "partial"
            } else if info.Concat == "final" {
                urls := []string{}
                for _, pid := range info.Parts {
                    urls = append(urls, mountPath+"/"+pid)
                }
                res.Headers["Upload-Concat"] = "final;" + strings.Join(urls, " ")
            }
            res.Status = 200
            res.Sent = true
        }

        patchHandler = func(req *Request, res *Response) {
            lamTusBaseHeaders(res)
            lamTusCorsHeaders(res)
            id := req.Params[":id"]

            ct := req.Header("Content-Type")
            if !strings.HasPrefix(ct, "application/offset+octet-stream") {
                res.Status = 415
                res.Headers["Content-Type"] = "text/plain"
                res.Body = "tus: Content-Type must be application/offset+octet-stream"
                res.Sent = true
                return
            }
            wantOffset, err := strconv.ParseInt(req.Header("Upload-Offset"), 10, 64)
            if err != nil {
                res.Status = 400
                res.Body = "tus: invalid Upload-Offset"
                res.Sent = true
                return
            }

            mu := lamTusLockFor(id)
            mu.Lock()
            defer mu.Unlock()

            info, err := lamTusReadInfo(storeDir, id)
            if err != nil {
                res.Status = 404
                res.Sent = true
                return
            }
            if info.Concat == "final" {
                res.Status = 403
                res.Headers["Content-Type"] = "text/plain"
                res.Body = "tus: cannot PATCH a final upload"
                res.Sent = true
                return
            }
            if info.Offset != wantOffset {
                res.Status = 409
                res.Headers["Content-Type"] = "text/plain"
                res.Body = fmt.Sprintf("tus: offset mismatch — got %d, want %d", wantOffset, info.Offset)
                res.Sent = true
                return
            }

            chunk := []byte(req.Body)
            csum := req.Header("Upload-Checksum")
            if csum != "" {
                valid, supported := lamTusVerifyChecksum(csum, chunk)
                if !supported {
                    res.Status = 400
                    res.Headers["Content-Type"] = "text/plain"
                    res.Body = "tus: unsupported checksum algorithm"
                    res.Sent = true
                    return
                }
                if !valid {
                    res.Status = 460
                    res.Headers["Content-Type"] = "text/plain"
                    res.Body = "tus: checksum mismatch"
                    res.Sent = true
                    return
                }
            }

            lamTusAppendChunk(storeDir, info, chunk, local)

            res.Headers["Upload-Offset"] = strconv.FormatInt(info.Offset, 10)
            res.Status = 204
            res.Sent = true
        }

        deleteHandler = func(req *Request, res *Response) {
            lamTusBaseHeaders(res)
            lamTusCorsHeaders(res)
            id := req.Params[":id"]
            os.Remove(lamTusBlobPath(storeDir, id))
            os.Remove(lamTusInfoPath(storeDir, id))
            lamTusLocks.Delete(id)
            res.Status = 204
            res.Sent = true
        }
    }

    srv.route("OPTIONS", mountPath, optionsHandler, None, "json")
    srv.route("POST", mountPath, postHandler, None, "json")
    srv.route("HEAD", mountPath + "/:id", headHandler, None, "json")
    srv.route("PATCH", mountPath + "/:id", patchHandler, None, "json")
    srv.route("DELETE", mountPath + "/:id", deleteHandler, None, "json")
}

func tusGc(storeDir: str, maxAgeHours: int) -> int {
    #- Delete upload pairs whose metadata creation time is older than
    ``maxAgeHours``. Returns the number of pairs removed. -  #
    n: int = 0
    go! {
        cutoff := time.Now().Add(-time.Duration(maxAgeHours) * time.Hour)
        if entries, err := os.ReadDir(storeDir); err == nil {
            for _, e := range entries {
                if !strings.HasSuffix(e.Name(), ".json") {
                    continue
                }
                id := strings.TrimSuffix(e.Name(), ".json")
                info, err := lamTusReadInfo(storeDir, id)
                if err != nil {
                    continue
                }
                if info.CreatedAt.Before(cutoff) {
                    os.Remove(lamTusBlobPath(storeDir, id))
                    os.Remove(lamTusInfoPath(storeDir, id))
                    lamTusLocks.Delete(id)
                    n++
                }
            }
        }
    }
    return n
}

go! {
    // Shared filesystem write path for creation-with-upload and PATCH. Keeping
    // this native preserves binary bytes, append semantics, and callback ABI.
    func lamTusAppendChunk(storeDir string, info *lamTusInfo, chunk []byte, srv *Server) {
        if len(chunk) == 0 {
            return
        }
        f, err := os.OpenFile(lamTusBlobPath(storeDir, info.ID), os.O_WRONLY|os.O_APPEND, 0o644)
        if err != nil {
            return
        }
        defer f.Close()
        n, err := f.Write(chunk)
        if err != nil {
            return
        }
        info.Offset += int64(n)
        if info.Offset >= info.Length {
            info.Complete = true
            info.FinishedAt = time.Now().UTC()
        }
        _ = lamTusWriteInfo(storeDir, info)

        if info.Complete {
            if cb, ok := srv.Ctx["__tusComplete"]; ok {
                if fn, ok := cb.(func(map[string]interface{})); ok {
                    payload := map[string]interface{}{
                        "id":       info.ID,
                        "length":   info.Length,
                        "offset":   info.Offset,
                        "metadata": info.Metadata,
                        "path":     lamTusBlobPath(storeDir, info.ID),
                    }
                    func() {
                        defer func() { _ = recover() }()
                        fn(payload)
                    }()
                }
            }
        }
    }
}
