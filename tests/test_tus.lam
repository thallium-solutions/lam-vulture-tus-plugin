# Test: @lam/vulture/tus-plugin — tus.io 1.0 resumable-upload protocol.
#
# Walks OPTIONS, POST, PATCH, HEAD, completion, conflict, and DELETE through
# Server.inject with a temporary on-disk store.
#
# expect: mount configured: true
# expect: options ver: 1.0.0
# expect: options ext: creation,creation-with-upload,termination,concatenation,checksum
# expect: create status: 201
# expect: create location prefix: /uploads/
# expect: id is uuid-len: 36
# expect: patch1 status: 204
# expect: patch1 offset: 6
# expect: head status: 200
# expect: head offset: 6
# expect: head length: 11
# expect: patch2 status: 204
# expect: patch2 offset: 11
# expect: conflict status: 409
# expect: file: hello world
# expect: delete status: 204
# expect: file exists after: false
# expect: ok

from @lam/vulture import Server, InjectResponse
from @lam/vulture/tus-plugin import tusUploads
from lamos import Os

func main() {
    tmp: str = Os.tempDir() + "/lam-vulture-tus-test"
    _ = Os.removeAll(tmp)

    server: Server = Server()
    print(f"mount configured: {tusUploads(server, '/uploads', tmp, 1024 * 1024).ok()}")

    options: InjectResponse = server.inject("OPTIONS", "/uploads")
    print(f"options ver: {options.header('Tus-Version')}")
    print(f"options ext: {options.header('Tus-Extension')}")

    createHeaders: dict[str, str] = {}
    createHeaders["Upload-Length"] = "11"
    createHeaders["Upload-Metadata"] = "filename aGVsbG8udHh0"
    createHeaders["Tus-Resumable"] = "1.0.0"
    created: InjectResponse = server.inject("POST", "/uploads", "", createHeaders)
    location: str = created.header("Location")
    print(f"create status: {created.status}")
    print(f"create location prefix: {location[:9]}")

    id: str = location[9:]
    print(f"id is uuid-len: {len(id)}")

    firstHeaders: dict[str, str] = {}
    firstHeaders["Tus-Resumable"] = "1.0.0"
    firstHeaders["Content-Type"] = "application/offset+octet-stream"
    firstHeaders["Upload-Offset"] = "0"
    first: InjectResponse = server.inject("PATCH", location, "hello ", firstHeaders)
    print(f"patch1 status: {first.status}")
    print(f"patch1 offset: {first.header('Upload-Offset')}")

    inspected: InjectResponse = server.inject("HEAD", location)
    print(f"head status: {inspected.status}")
    print(f"head offset: {inspected.header('Upload-Offset')}")
    print(f"head length: {inspected.header('Upload-Length')}")

    secondHeaders: dict[str, str] = {}
    secondHeaders["Tus-Resumable"] = "1.0.0"
    secondHeaders["Content-Type"] = "application/offset+octet-stream"
    secondHeaders["Upload-Offset"] = "6"
    second: InjectResponse = server.inject("PATCH", location, "world", secondHeaders)
    print(f"patch2 status: {second.status}")
    print(f"patch2 offset: {second.header('Upload-Offset')}")

    conflictHeaders: dict[str, str] = {}
    conflictHeaders["Tus-Resumable"] = "1.0.0"
    conflictHeaders["Content-Type"] = "application/offset+octet-stream"
    conflictHeaders["Upload-Offset"] = "999"
    conflict: InjectResponse = server.inject("PATCH", location, "x", conflictHeaders)
    print(f"conflict status: {conflict.status}")

    print(f"file: {Os.readFile(tmp + '/' + id).unwrap()}")

    deleted: InjectResponse = server.inject("DELETE", location)
    print(f"delete status: {deleted.status}")
    print(f"file exists after: {Os.fileExists(tmp + '/' + id).unwrap()}")

    _ = Os.removeAll(tmp)
    print("ok")
}
