# Test: @lam/vulture/tus-plugin Concatenation and Checksum extensions.
#
# expect: opt-algo: sha1,sha256,md5
# expect: opt-ext: creation,creation-with-upload,termination,concatenation,checksum
# expect: checksum-good: 204
# expect: checksum-bad: 460
# expect: checksum-bad-algo: 400
# expect: part-a-patch: 204
# expect: part-b-patch: 204
# expect: head-partial-concat: partial
# expect: final-status: 201
# expect: final-length-11: true
# expect: final-complete: 200
# expect: final-content: hello world
# expect: final-concat-header-prefix: final;
# expect: patch-final-forbidden: 403

from @lam/vulture import Server, InjectResponse
from @lam/vulture/tus-plugin import tusUploads
from lamos import Os

go! {
    import (
        "crypto/sha1"
        "encoding/base64"
    )
}

func main() {
    tmp: str = Os.tempDir() + "/lam-vulture-tus-ext"
    _ = Os.removeAll(tmp)

    server: Server = Server()
    _ = tusUploads(server, "/u", tmp, 1024 * 1024).unwrap()

    options: InjectResponse = server.inject("OPTIONS", "/u")
    print(f"opt-algo: {options.header('Tus-Checksum-Algorithm')}")
    print(f"opt-ext: {options.header('Tus-Extension')}")

    checksumCreateHeaders: dict[str, str] = {}
    checksumCreateHeaders["Upload-Length"] = "5"
    checksumCreateHeaders["Tus-Resumable"] = "1.0.0"
    checksumUpload: InjectResponse = server.inject("POST", "/u", "", checksumCreateHeaders)
    checksumLocation: str = checksumUpload.header("Location")

    goodChecksum: str = ""
    go! {
        sum := sha1.Sum([]byte("hello"))
        goodChecksum = "sha1 " + base64.StdEncoding.EncodeToString(sum[:])
    }

    goodHeaders: dict[str, str] = {}
    goodHeaders["Tus-Resumable"] = "1.0.0"
    goodHeaders["Content-Type"] = "application/offset+octet-stream"
    goodHeaders["Upload-Offset"] = "0"
    goodHeaders["Upload-Checksum"] = goodChecksum
    good: InjectResponse = server.inject("PATCH", checksumLocation, "hello", goodHeaders)
    print(f"checksum-good: {good.status}")

    mismatchUpload: InjectResponse = server.inject("POST", "/u", "", checksumCreateHeaders)
    mismatchLocation: str = mismatchUpload.header("Location")

    mismatchHeaders: dict[str, str] = {}
    mismatchHeaders["Tus-Resumable"] = "1.0.0"
    mismatchHeaders["Content-Type"] = "application/offset+octet-stream"
    mismatchHeaders["Upload-Offset"] = "0"
    mismatchHeaders["Upload-Checksum"] = "sha1 YWFhYWFhYWFhYWFhYWFhYWFhYWE="
    mismatch: InjectResponse = server.inject("PATCH", mismatchLocation, "hello", mismatchHeaders)
    print(f"checksum-bad: {mismatch.status}")

    unsupportedHeaders: dict[str, str] = {}
    unsupportedHeaders["Tus-Resumable"] = "1.0.0"
    unsupportedHeaders["Content-Type"] = "application/offset+octet-stream"
    unsupportedHeaders["Upload-Offset"] = "0"
    unsupportedHeaders["Upload-Checksum"] = "whirlpool ZmFrZQ=="
    unsupported: InjectResponse = server.inject("PATCH", mismatchLocation, "hello", unsupportedHeaders)
    print(f"checksum-bad-algo: {unsupported.status}")

    partAHeaders: dict[str, str] = {}
    partAHeaders["Upload-Length"] = "6"
    partAHeaders["Tus-Resumable"] = "1.0.0"
    partAHeaders["Upload-Concat"] = "partial"
    partA: InjectResponse = server.inject("POST", "/u", "", partAHeaders)
    partALocation: str = partA.header("Location")

    partBHeaders: dict[str, str] = {}
    partBHeaders["Upload-Length"] = "5"
    partBHeaders["Tus-Resumable"] = "1.0.0"
    partBHeaders["Upload-Concat"] = "partial"
    partB: InjectResponse = server.inject("POST", "/u", "", partBHeaders)
    partBLocation: str = partB.header("Location")

    uploadAHeaders: dict[str, str] = {}
    uploadAHeaders["Tus-Resumable"] = "1.0.0"
    uploadAHeaders["Content-Type"] = "application/offset+octet-stream"
    uploadAHeaders["Upload-Offset"] = "0"
    uploadedA: InjectResponse = server.inject("PATCH", partALocation, "hello ", uploadAHeaders)
    print(f"part-a-patch: {uploadedA.status}")

    uploadBHeaders: dict[str, str] = {}
    uploadBHeaders["Tus-Resumable"] = "1.0.0"
    uploadBHeaders["Content-Type"] = "application/offset+octet-stream"
    uploadBHeaders["Upload-Offset"] = "0"
    uploadedB: InjectResponse = server.inject("PATCH", partBLocation, "world", uploadBHeaders)
    print(f"part-b-patch: {uploadedB.status}")

    inspectedPart: InjectResponse = server.inject("HEAD", partALocation)
    print(f"head-partial-concat: {inspectedPart.header('Upload-Concat')}")

    finalHeaders: dict[str, str] = {}
    finalHeaders["Tus-Resumable"] = "1.0.0"
    finalHeaders["Upload-Concat"] = f"final;{partALocation} {partBLocation}"
    finalUpload: InjectResponse = server.inject("POST", "/u", "", finalHeaders)
    finalLocation: str = finalUpload.header("Location")
    print(f"final-status: {finalUpload.status}")

    inspectedFinal: InjectResponse = server.inject("HEAD", finalLocation)
    finalConcat: str = inspectedFinal.header("Upload-Concat")
    print(f"final-length-11: {inspectedFinal.header('Upload-Length') == '11'}")
    print(f"final-complete: {inspectedFinal.status}")

    finalId: str = finalLocation[3:]
    print(f"final-content: {Os.readFile(tmp + '/' + finalId).unwrap()}")

    marker: str = ""
    if finalConcat.startsWith("final;") {
        marker = "final;"
    }
    print(f"final-concat-header-prefix: {marker}")

    finalPatchHeaders: dict[str, str] = {}
    finalPatchHeaders["Tus-Resumable"] = "1.0.0"
    finalPatchHeaders["Content-Type"] = "application/offset+octet-stream"
    finalPatchHeaders["Upload-Offset"] = "11"
    finalPatch: InjectResponse = server.inject("PATCH", finalLocation, "x", finalPatchHeaders)
    print(f"patch-final-forbidden: {finalPatch.status}")

    _ = Os.removeAll(tmp)
}
